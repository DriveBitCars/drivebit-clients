# Nginx: боты всегда получают HTML от Prerender (Docker, 127.0.0.1:3000), не статику prerender-bot*.html.
#
# ВАЖНО — уберите из боевого конфига устаревшую схему:
#   map $host$is_bot $bot_home_file { ... }
#   location = / { try_files $bot_home_file ... }
# Иначе бот на / будет по-прежнему получать файл с диска, а не вывод Chromium.
#
# Подключение:
#   1) В http { } — include nginx-prerender-cache-http.conf (см. nginx-prerender-cache-http.conf.example)
#   2) Prerender: scripts/prerender-docker/ → 127.0.0.1:3000
#   3) Прогрев: scripts/warm-prerender-nightly.sh + cron
#
# Как это работает: для бота return 418 → named location @prerender_bot → proxy_pass :3000.
# Chromium в контейнере открывает публичный URL с обычным UA (не бот) → nginx отдаёт SPA/статику
# «как человеку» → Prerender возвращает отрендеренный HTML → nginx кэширует (proxy_cache).
# Быстро для бота = в основном HIT по proxy_cache; MISS может занимать десятки секунд (Chromium).
# proxy_cache_lock_timeout должен быть ≥ времени рендера, иначе несколько ботов на MISS одновременно
# пойдут в Prerender параллельно и разгонят CPU/RAM.
# proxy_cache_valid 1d — ответ считается свежим 24 ч, затем следующий запрос пойдёт в Prerender и обновит кэш.

map $http_user_agent $is_bot {
    default 0;
    ~*googlebot 1;
    ~*yandex 1;
    ~*bingbot 1;
    ~*baiduspider 1;
    ~*bot 1;
    ~*crawler 1;
    ~*spider 1;
}

server {
    listen 80;
    server_name your-domain.com;
    root /var/www/drivebit-clients;
    index index.html;

    error_page 418 = @prerender_bot;

    gzip on;
    gzip_types text/html text/css application/javascript application/json;

    # prerender-bot*.html: люди — файл с диска; боты — только через Prerender Docker
    location ~* ^/prerender-bot(-ru)?\.html$ {
        if ($is_bot) {
            return 418;
        }
        try_files $uri =404;
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    # car/*.html: люди — статика из деплоя; боты — HTML из Prerender (рендер SPA/страницы как в браузере)
    location ~* ^/car/[^/]+\.html$ {
        if ($is_bot) {
            return 418;
        }
        try_files $uri /index.html;
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /publicbct/avatars/ {
        proxy_pass http://213.171.27.185:9000/publicbct/avatars/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache_valid 200 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    location = /login-by-phone {
        try_files /login-by-phone.html /index.html;
    }

    location = /login-by-mail {
        try_files /login-by-mail.html /index.html;
    }

    location = / {
        if ($is_bot) {
            return 418;
        }
        try_files /index.html =404;
    }

    location / {
        if ($is_bot) {
            return 418;
        }
        try_files $uri $uri/ /index.html;
    }

    location @prerender_bot {
        internal;
        rewrite ^ /$scheme://$host$request_uri break;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 30s;
        proxy_buffering on;

        proxy_cache prerender_cache;
        proxy_cache_key "$scheme$host$request_uri";
        proxy_cache_valid 200 1d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 300s;
        add_header X-Prerender-Nginx-Cache $upstream_cache_status always;

        proxy_ignore_headers Set-Cookie;
    }
}
