# Пример конфигурации Nginx для пререндеринга
# Сохраните это в /etc/nginx/sites-available/drivebit-clients

server {
    listen 80;
    server_name your-domain.com;
    root /var/www/drivebit-clients;
    index index.html;

    # Сжатие
    gzip on;
    gzip_types text/html text/css application/javascript application/json;

    # Кеширование статических файлов
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Проксирование аватаров на внешний сервер
    # /publicbct/avatars/... -> http://213.171.27.185:9000/publicbct/avatars/...
    location /publicbct/avatars/ {
        proxy_pass http://213.171.27.185:9000/publicbct/avatars/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Кеширование изображений
        proxy_cache_valid 200 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    # Пререндеренные страницы
    # Если файл существует - отдаем его, иначе fallback на index.html
    
    location = /login-by-phone {
        try_files /login-by-phone.html /index.html;
    }

    location = /login-by-mail {
        try_files /login-by-mail.html /index.html;
    }

    # Главная страница
    location = / {
        try_files /index.html =404;
    }

    # Все остальные пути - fallback на index.html (SPA роутинг)
    location / {
        try_files $uri $uri/ /index.html;
    }
}

