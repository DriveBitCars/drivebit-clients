# Подключить один раз внутри блока http { } (например через include в /etc/nginx/nginx.conf):
#
#   include /etc/nginx/snippets/nginx-prerender-cache-http.conf;
#
# Перед первым запуском:
#   sudo mkdir -p /var/cache/nginx/prerender
#   sudo chown -R www-data:www-data /var/cache/nginx/prerender
#
# inactive=2d — файлы без обращения удаляются через 2 суток (свежесть ответа задаётся proxy_cache_valid 1d в server).
# max_size — при большом каталоге машин увеличьте (например 2g–4g).

proxy_cache_path /var/cache/nginx/prerender levels=1:2 keys_zone=prerender_cache:50m max_size=2g inactive=2d use_temp_path=off;
